<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>
		<security>
			<requestFiltering>
				<!-- 250 MiB request cap so IIS does not block multi-image attraction uploads. -->
				<requestLimits maxAllowedContentLength="262144000" />
			</requestFiltering>
		</security>
	</system.webServer>
</configuration>
