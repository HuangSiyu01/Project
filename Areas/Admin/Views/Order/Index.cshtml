@using Project.Models
@using System.Globalization
@model IEnumerable<Project.Models.Order>

@{
    ViewData["Title"] = "Order Management";
    var nz = (CultureInfo)CultureInfo.GetCultureInfo("en-NZ").Clone();
    nz.NumberFormat.CurrencySymbol = "NZ$";
    nz.NumberFormat.CurrencyPositivePattern = 2;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold mb-1">Order Management</h1>
            <p class="text-muted fs-5 mb-0">Manage customer orders and refund requests.</p>
        </div>
        <span class="badge bg-primary fs-5 px-3 py-2">Total Orders: @(Model?.Count() ?? 0)</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">Order ID</th>
                        <th class="py-3">Customer</th>
                        <th class="py-3">Order Date</th>
                        <th class="py-3">Amount After Refunds</th>
                        <th class="py-3">Order Status</th>
                        <th class="py-3">Refund Status</th>
                        <th class="text-end px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            var refunds = order.RefundRequests?.ToList() ?? new List<RefundRequest>();
                            var completedRefunds = refunds
                            .Where(r => r.RefundStatus == SD.RefundCompleted)
                            .ToList();
                            var latestRefund = refunds
                            .OrderByDescending(r => r.RequestedAt)
                            .FirstOrDefault();

                            var refundedAmount = completedRefunds.Sum(r => r.RefundAmount);
                            var netAmount = Math.Max(order.TotalAmount - refundedAmount, 0m);
                            var legacyCompletedRefundExists = completedRefunds.Any(r =>
                            !r.OrderItemId.HasValue || !r.RefundQuantity.HasValue);
                            var totalPurchasedQuantity = order.Items?.Sum(i => i.Quantity) ?? 0;
                            var totalRefundedQuantity = completedRefunds
                            .Where(r => r.OrderItemId.HasValue && r.RefundQuantity.HasValue)
                            .Sum(r => r.RefundQuantity ?? 0);
                            var totalPendingQuantity = refunds
                            .Where(r => r.RefundStatus == SD.RefundPending || r.RefundStatus == SD.RefundApproved)
                            .Where(r => r.OrderItemId.HasValue && r.RefundQuantity.HasValue)
                            .Sum(r => r.RefundQuantity ?? 0);
                            var totalRemainingQuantity = Math.Max(totalPurchasedQuantity - totalRefundedQuantity, 0);

                            var customerName = !string.IsNullOrWhiteSpace(order.User?.DisplayName)
                            ? order.User!.DisplayName
                            : (!string.IsNullOrWhiteSpace(order.User?.UserName) &&
                            !string.Equals(order.User.UserName, order.User.Email, StringComparison.OrdinalIgnoreCase)
                            ? order.User.UserName
                            : "Customer");

                            var orderBadgeClass = order.OrderStatus == SD.StatusApproved
                            ? "bg-success"
                            : order.OrderStatus == SD.StatusPending
                            ? "bg-warning text-dark"
                            : order.OrderStatus == SD.StatusCancelled
                            ? "bg-secondary"
                            : "bg-primary";

                            var refundBadgeClass = latestRefund == null
                            ? ""
                            : latestRefund.RefundStatus == SD.RefundPending
                            ? "bg-danger"
                            : latestRefund.RefundStatus == SD.RefundApproved
                            ? "bg-warning text-dark"
                            : latestRefund.RefundStatus == SD.RefundRejected
                            ? "bg-secondary"
                            : latestRefund.RefundStatus == SD.RefundCompleted
                            ? "bg-success"
                            : "bg-primary";

                            <tr>
                                <td class="px-4 py-3 fw-semibold">#@order.Id</td>
                                <td class="py-3">
                                    <div class="fw-semibold">@customerName</div>
                                    @if (!string.IsNullOrWhiteSpace(order.User?.Email))
                                    {
                                        <small class="text-muted">@order.User.Email</small>
                                    }
                                </td>
                                <td class="py-3">@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm", nz)</td>
                                <td class="py-3">
                                    <div class="fw-bold">@netAmount.ToString("C", nz)</div>
                                    <div class="small text-muted">Original: @order.TotalAmount.ToString("C", nz)</div>
                                    <div class="small text-success">Refunded: −@refundedAmount.ToString("C", nz)</div>
                                    @if (legacyCompletedRefundExists)
                                    {
                                        <div class="small text-warning">Legacy refund: ticket quantity not recorded</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mt-1">
                                            Tickets: @totalPurchasedQuantity purchased · @totalRefundedQuantity refunded · @totalRemainingQuantity not refunded
                                        </div>
                                    }
                                    @if (totalPendingQuantity > 0)
                                    {
                                        <div class="small text-warning">Refund under review: @totalPendingQuantity ticket(s)</div>
                                    }
                                </td>
                                <td class="py-3"><span class="badge @orderBadgeClass">@order.OrderStatus</span></td>
                                <td class="py-3">
                                    @if (latestRefund == null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge @refundBadgeClass">@latestRefund.RefundStatus</span>
                                        <div class="small text-muted mt-1">Latest: @latestRefund.RefundAmount.ToString("C", nz)</div>
                                    }
                                </td>
                                <td class="text-end px-4 py-3">
                                    <a href="@Url.Action("Details", "Order", new { area = "Admin", id = order.Id })" class="btn btn-primary">
                                        <i class="bi bi-gear"></i> Manage
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                <p class="text-muted mt-2 mb-0">No orders have been placed yet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="small text-muted mt-3 mb-0">
        The amount shown is the order total minus completed refunds. Original order values are retained for transaction history. Pending refunds are not deducted until Stripe confirms completion.
    </p>
</div>