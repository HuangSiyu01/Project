@model IEnumerable<Project.Models.Attraction>

@{
    ViewData["Title"] = "Attraction Management";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">Attraction Management</h1>
            <p class="text-muted mb-0">Create attractions, upload photos, update ticket prices, and manage availability.</p>
        </div>
        <a asp-area="Admin" asp-controller="Attractions" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Attraction
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Attraction</th>
                        <th>Location</th>
                        <th>Ticket Price</th>
                        <th>Photos</th>
                        <th>Availability</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var attraction in Model)
                        {
                            <tr>
                                <td class="ps-4" style="min-width:260px;">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@Url.Content(attraction.ImageUrl)"
                                             alt="@attraction.Name"
                                             class="rounded"
                                             style="width:88px;height:64px;object-fit:cover;"
                                             onerror="this.onerror=null;this.style.display='none';" />
                                        <div>
                                            <div class="fw-semibold">@attraction.Name</div>
                                            <div class="small text-muted">ID: @attraction.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@attraction.City</td>
                                <td class="fw-semibold">NZ$ @attraction.TicketPrice.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(1 + (attraction.Images?.Count ?? 0)) photo(s)</td>
                                <td>
                                    @if (attraction.IsAvailable)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Offline</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                        <a asp-area="Admin"
                                           asp-controller="Attractions"
                                           asp-action="Edit"
                                           asp-route-id="@attraction.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <form asp-area="Admin"
                                              asp-controller="Attractions"
                                              asp-action="ToggleAvailability"
                                              asp-route-id="@attraction.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (attraction.IsAvailable)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Take this attraction offline? It will no longer appear in public search, but historical orders will be preserved.');">
                                                    <i class="bi bi-eye-slash"></i> Take Offline
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-eye"></i> Publish
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-geo-alt fs-1 text-muted"></i>
                                <h5 class="mt-3">No attractions found</h5>
                                <p class="text-muted">Add an attraction to make it available in the website's Attraction Tickets search.</p>
                                <a asp-area="Admin" asp-controller="Attractions" asp-action="Create" class="btn btn-primary">
                                    <i class="bi bi-plus-circle"></i> Add First Attraction
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="small text-muted mt-3 mb-0">
        Published attractions are stored in the same Attractions table used by the public attraction search. Taking an attraction offline preserves its existing orders and tickets.
    </p>
</div>

