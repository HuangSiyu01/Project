@model Project.Models.Attraction

@{
    ViewData["Title"] = Model.Name;

    var photoUrls = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        photoUrls.Add(Url.Content(Model.ImageUrl));
    }

    if (Model.Images != null)
    {
        foreach (var item in Model.Images)
        {
            if (string.IsNullOrWhiteSpace(item.ImageUrl))
            {
                continue;
            }

            var imageUrl = Url.Content(item.ImageUrl);

            if (!photoUrls.Contains(
                imageUrl,
                StringComparer.OrdinalIgnoreCase))
            {
                photoUrls.Add(imageUrl);
            }
        }
    }
}

<div class="container mt-4">

    <!-- Add-to-cart feedback -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Back button -->
    <a asp-controller="Post"
       asp-action="Index"
       asp-route-keyword="@ViewBag.Keyword"
       asp-route-searchType="attractions"
       class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Back
    </a>

    <!-- Attraction information -->
    <h1 class="fw-bold mb-2">@Model.Name</h1>

    <p class="text-muted">
        <i class="bi bi-geo-alt-fill text-danger"></i>
        @Model.City
    </p>

    <p>@Model.Description</p>

    <!-- Attraction photos -->
    <h4 class="mt-4">Photos</h4>

    @if (photoUrls.Count == 0)
    {
        <p class="text-muted">No photos available.</p>
    }
    else
    {
        <div class="row g-2 mt-3">
            @for (var i = 0; i < photoUrls.Count; i++)
            {
                <div class="col-6 col-md-4">
                    <img src="@photoUrls[i]"
                         alt="@Model.Name"
                         class="img-fluid rounded-3 shadow-sm"
                         style="cursor:pointer;height:200px;object-fit:cover;width:100%;"
                         data-bs-toggle="modal"
                         data-bs-target="#attractionImageModal"
                         data-image-src="@photoUrls[i]"
                         onerror="this.onerror=null; this.style.display='none';" />
                </div>
            }
        </div>
    }

    <!-- Ticket information and shopping cart -->
    <div class="mt-4 mb-5">
        <h4>Ticket Information</h4>

        <p class="fs-5 fw-bold">
            Ticket Price: NZ$ @Model.TicketPrice.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
        </p>

        @if (User.IsInRole("Admin"))
        {
            <div class="alert alert-info mt-3" role="status">
                <i class="bi bi-info-circle"></i>
                Administrators can view attraction details but cannot add tickets to the shopping cart.
            </div>
        }
        else if (Model.IsAvailable)
        {
            <form asp-controller="Cart"
                  asp-action="Add"
                  method="post"
                  class="mt-3">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="attractionId"
                       value="@Model.Id" />

                <input type="hidden"
                       name="returnUrl"
                       value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="mb-3" style="max-width:150px;">
                    <label for="quantity" class="form-label">
                        Quantity
                    </label>

                    <input type="number"
                           id="quantity"
                           name="quantity"
                           value="1"
                           min="1"
                           max="20"
                           step="1"
                           required
                           class="form-control" />
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-cart-plus"></i>
                    Add to Cart
                </button>

                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-outline-primary ms-2">
                    <i class="bi bi-cart"></i>
                    View Cart
                </a>
            </form>
        }
        else
        {
            <button type="button"
                    class="btn btn-secondary"
                    disabled>
                <i class="bi bi-cart-x"></i>
                Currently Unavailable
            </button>
        }
    </div>
</div>

<!-- Image Modal -->
<div class="modal fade"
     id="attractionImageModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark">

            <button type="button"
                    class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                    style="z-index:2;"
                    data-bs-dismiss="modal"
                    aria-label="Close">
            </button>

            <div class="modal-body p-0">
                <div class="d-flex align-items-center justify-content-center gap-2">

                    <button type="button"
                            id="previousAttractionPhoto"
                            class="btn btn-dark flex-shrink-0"
                            aria-label="Previous photo">
                        <i class="bi bi-chevron-left fs-3"></i>
                    </button>

                    <div class="text-center flex-grow-1"
                         style="min-width:0;">
                        <img id="modalAttractionImage"
                             src=""
                             class="img-fluid"
                             alt="" />
                    </div>

                    <button type="button"
                            id="nextAttractionPhoto"
                            class="btn btn-dark flex-shrink-0"
                            aria-label="Next photo">
                        <i class="bi bi-chevron-right fs-3"></i>
                    </button>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('attractionImageModal');
            var modalImage = document.getElementById('modalAttractionImage');
            var previousButton = document.getElementById('previousAttractionPhoto');
            var nextButton = document.getElementById('nextAttractionPhoto');

            var galleryImages = Array.from(
                document.querySelectorAll(
                    '[data-bs-target="#attractionImageModal"]'
                )
            );

            var currentIndex = 0;

            function showPhoto(index) {
                if (galleryImages.length === 0) {
                    return;
                }

                currentIndex =
                    (index + galleryImages.length) % galleryImages.length;

                var selectedImage = galleryImages[currentIndex];

                modalImage.src =
                    selectedImage.getAttribute('data-image-src');

                modalImage.alt =
                    selectedImage.getAttribute('alt') || '';

                var showArrows = galleryImages.length > 1;

                previousButton.style.display =
                    showArrows ? '' : 'none';

                nextButton.style.display =
                    showArrows ? '' : 'none';
            }

            if (!modal) {
                return;
            }

            modal.addEventListener('show.bs.modal', function (event) {
                var trigger = event.relatedTarget;

                if (!trigger) {
                    return;
                }

                var index = galleryImages.indexOf(trigger);

                if (index !== -1) {
                    showPhoto(index);
                }
            });

            previousButton.addEventListener('click', function () {
                showPhoto(currentIndex - 1);
            });

            nextButton.addEventListener('click', function () {
                showPhoto(currentIndex + 1);
            });

            document.addEventListener('keydown', function (event) {
                if (!modal.classList.contains('show')) {
                    return;
                }

                if (event.key === 'ArrowLeft') {
                    event.preventDefault();
                    showPhoto(currentIndex - 1);
                } else if (event.key === 'ArrowRight') {
                    event.preventDefault();
                    showPhoto(currentIndex + 1);
                }
            });

            modal.addEventListener('hidden.bs.modal', function () {
                modalImage.src = '';
            });
        });
    </script>
}