@using Project.Models
@using System.Globalization
@model IEnumerable<Project.Models.Ticket>

@{
    ViewData["Title"] = "My E-Tickets";
    var nz = (CultureInfo)CultureInfo.GetCultureInfo("en-NZ").Clone();
    nz.NumberFormat.CurrencySymbol = "NZ$";
    nz.NumberFormat.CurrencyPositivePattern = 2;
    var tickets = Model?.ToList() ?? new List<Ticket>();
    var validTickets = tickets.Where(t => t.Status == SD.TicketActive).ToList();
    var refundedTickets = tickets.Where(t => t.Status != SD.TicketActive).ToList();
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">My E-Tickets</h1>
            <p class="text-muted mb-0">View your valid attraction tickets and keep a record of refunded tickets.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4 ticket-summary">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Valid tickets</div>
                        <div class="display-6 fw-bold">@validTickets.Count</div>
                    </div>
                    <i class="bi bi-ticket-perforated fs-1 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Refunded tickets</div>
                        <div class="display-6 fw-bold">@refundedTickets.Count</div>
                    </div>
                    <i class="bi bi-ticket-perforated fs-1 text-secondary"></i>
                </div>
            </div>
        </div>
    </div>

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">Valid Tickets</h2>
            <span class="badge bg-success">@validTickets.Count valid</span>
        </div>
        @if (!validTickets.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-ticket-perforated fs-1 text-muted"></i>
                    <h5 class="mt-3">No valid e-tickets</h5>
                    <p class="text-muted">E-tickets appear here after your paid order has been approved by an administrator. Refunded tickets are kept in the history below.</p>
                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary">
                        Back to Homepage
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var ticket in validTickets)
                {
                    var attractionName = ticket.OrderItem?.Attraction?.Name ?? "Attraction";
                    var city = ticket.OrderItem?.Attraction?.City;
                    var price = ticket.OrderItem?.UnitPrice ?? 0m;
                    <div class="col-lg-6 ticket-card-wrap">
                        <article class="card border-0 shadow-sm h-100 ticket-card">
                            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                                <span class="fw-semibold"><i class="bi bi-check-circle"></i> Valid E-Ticket</span>
                                <span class="badge bg-light text-success">@ticket.Status</span>
                            </div>
                            <div class="card-body">
                                <h3 class="h5 fw-bold">@attractionName</h3>
                                @if (!string.IsNullOrWhiteSpace(city))
                                {
                                    <p class="text-muted mb-3"><i class="bi bi-geo-alt"></i> @city</p>
                                }
                                <div class="ticket-code-box rounded p-3 mb-3">
                                    <div class="small text-muted">E-Ticket Number</div>
                                    <div class="fs-5 fw-bold ticket-code">@ticket.TicketNumber</div>
                                    <div class="small text-muted mt-1">Present this number when requested by the attraction.</div>
                                </div>
                                <dl class="row mb-0 small">
                                    <dt class="col-5 text-muted">Order</dt>
                                    <dd class="col-7">#@ticket.OrderId</dd>
                                    <dt class="col-5 text-muted">Ticket issued</dt>
                                    <dd class="col-7">@ticket.IssuedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm", nz)</dd>
                                    <dt class="col-5 text-muted">Ticket value</dt>
                                    <dd class="col-7">@price.ToString("C", nz)</dd>
                                </dl>
                                <div class="mt-3">
                                    <a asp-area="Customer"
                                       asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@ticket.OrderId"
                                       class="btn btn-sm btn-outline-primary">
                                        View Order
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">Refunded Ticket History</h2>
            <span class="badge bg-secondary">@refundedTickets.Count refunded</span>
        </div>
        @if (!refundedTickets.Any())
        {
            <div class="border rounded p-3 text-muted">No refunded tickets.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket Number</th>
                            <th>Attraction</th>
                            <th>Order</th>
                            <th>Refunded Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in refundedTickets.OrderByDescending(t => t.RefundedAt))
                        {
                            <tr>
                                <td class="text-break"><code>@ticket.TicketNumber</code></td>
                                <td>@(ticket.OrderItem?.Attraction?.Name ?? "Attraction")</td>
                                <td>#@ticket.OrderId</td>
                                <td>@(ticket.RefundedAt.HasValue? ticket.RefundedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm", nz) : "—")</td>
                                <td><span class="badge bg-secondary">Refunded / Invalid</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <style>
        .ticket-code-box {
            background: #f8f9fa;
            border: 1px dashed #adb5bd;
        }

        .ticket-code {
            overflow-wrap: anywhere;
            letter-spacing: .04em;
        }
    </style>
}