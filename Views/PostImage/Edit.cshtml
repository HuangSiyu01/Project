@model PostImage

@{
    ViewData["Title"] = "Edit Image";
}

<div class="container mt-4">
    <h2>Edit Image</h2>

    <div class="mb-3">
        <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height:300px;" />
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="@Model.Id" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Replace with new image</label>
            <input type="file" name="image" accept="image/*" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-postId="@Model.PostId" class="btn btn-secondary">Back</a>
    </form>
</div>