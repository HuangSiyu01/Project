@model PostImage

@{
    ViewData["Title"] = "Delete Image";
}

<div class="container mt-4">
    <h2>Delete Image</h2>
    <p class="text-danger">Are you sure you want to delete this image?</p>

    <div class="mb-3">
        <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height:300px;" />
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" asp-route-postId="@Model.PostId" class="btn btn-secondary">Cancel</a>
    </form>
</div>