@model Project.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <h2>@Model.DisplayName</h2>

    <p class="text-muted">
        <strong>Followers:</strong> @Model.FollowerUsers.Count &nbsp;|&nbsp;
        <strong>Following:</strong> @Model.FollowingUsers.Count
    </p>

    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <h4>My Posts</h4>
        <a asp-controller="Post" asp-action="Create" class="btn btn-primary">+ Create Post</a>
    </div>

    @if (!Model.MyPosts.Any())
    {
        <p class="text-muted">You haven't created any posts yet.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var post in Model.MyPosts)
            {
                var firstImage = post.Images?.FirstOrDefault();
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id"
                       class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-0">
                            @if (firstImage != null)
                            {
                                <img src="@firstImage.ImageUrl" class="card-img-top" style="height:180px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                    <span class="text-muted">No image</span>
                                </div>
                            }
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@post.Title</h6>
                                <p class="text-muted small mb-0">@post.Location</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <hr class="mt-5" />

    <h4>Liked Posts</h4>
    @if (!Model.LikedPosts.Any())
    {
        <p class="text-muted">No liked posts.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var post in Model.LikedPosts)
            {
                var firstImage = post.Images?.FirstOrDefault();
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id"
                       class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-0">
                            @if (firstImage != null)
                            {
                                <img src="@firstImage.ImageUrl" class="card-img-top" style="height:180px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                    <span class="text-muted">No image</span>
                                </div>
                            }
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@post.Title</h6>
                                <p class="text-muted small mb-0">@post.Location</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <hr class="mt-5" />

    <h4>Favorited Posts</h4>
    @if (!Model.FavoritePosts.Any())
    {
        <p class="text-muted">No favorited posts.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var post in Model.FavoritePosts)
            {
                var firstImage = post.Images?.FirstOrDefault();
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id"
                       class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-0">
                            @if (firstImage != null)
                            {
                                <img src="@firstImage.ImageUrl" class="card-img-top" style="height:180px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                    <span class="text-muted">No image</span>
                                </div>
                            }
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">@post.Title</h6>
                                <p class="text-muted small mb-0">@post.Location</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <hr class="mt-5" />

    <h4>Following</h4>
    @if (!Model.FollowingUsers.Any())
    {
        <p class="text-muted">You are not following anyone.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var u in Model.FollowingUsers)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a asp-controller="Profile" asp-action="UserProfile" asp-route-id="@u.Id">
                        @u.DisplayName
                    </a>
                    <form asp-controller="Interaction" asp-action="ToggleFollow" method="post">
                        <input type="hidden" name="followeeId" value="@u.Id" />
                        <input type="hidden" name="returnUrl" value="/Profile/Index" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Unfollow</button>
                    </form>
                </li>
            }
        </ul>
    }

    <hr class="mt-5" />

    <h4>Followers</h4>
    @if (!Model.FollowerUsers.Any())
    {
        <p class="text-muted">No followers yet.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var u in Model.FollowerUsers)
            {
                <li class="list-group-item">
                    <a asp-controller="Profile" asp-action="UserProfile" asp-route-id="@u.Id">
                        @u.DisplayName
                    </a>
                </li>
            }
        </ul>
    }
</div>